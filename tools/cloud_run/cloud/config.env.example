# Copy to config.env and fill in values.
GCP_PROJECT=your-gcp-project
GCP_REGION=us-west1
GCS_BUCKET=your-job-search-bucket

# Cloud Run Job name for full protocols pipeline
JOB_NAME=run-protocols

# Optional tuning
# MATCH_THRESHOLD=80
# MAX_GENERATE_PER_RUN=5
# OPENAI_MODEL_SCORE=gpt-4o-mini
# OPENAI_MODEL_GENERATE=gpt-4o
# SKIP_LINKEDIN=1

# Secret Manager names (created by setup_secrets.sh)
OPENAI_SECRET=openai-api-key
GMAIL_TOKEN_SECRET=gmail-token
GMAIL_CLIENT_SECRET=gmail-oauth-client
# LINKED_API_SECRET=linked-api-token
# LINKED_IDENT_SECRET=linked-identification-token

# Scheduler (optional — weekdays 7am PT)
# SCHEDULER_NAME=run-protocols-weekdays
# SCHEDULE_CRON="0 7 * * 1-5"
# SCHEDULE_TIMEZONE=America/Los_Angeles
