# Copy to config.env and fill in your GCP project values.
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-west1
GCS_BUCKET=your-gcp-project-id-recruiter-inbox
JOB_NAME=recruiter-scan
ARTIFACT_REPO=job-search
SCHEDULER_NAME=recruiter-scan-weekdays

# Cloud Scheduler cron (America/Los_Angeles). Default: every 10 min, Mon–Fri only.
# Examples:
#   */10 * * * 1-5          every 10 minutes, weekdays
#   */10 8-18 * * 1-5       every 10 minutes, 8 AM–6 PM weekdays
SCHEDULE_CRON=*/10 * * * 1-5
SCHEDULE_TIMEZONE=America/Los_Angeles

# Optional scan tuning (passed to the Cloud Run Job)
# GMAIL_QUERY=newer_than:7d is:unread subject:python
# SCAN_MAX_RESULTS=25
# SCAN_MIN_SCORE=3

# Secret Manager secret ids (created by setup_secrets.sh)
GMAIL_TOKEN_SECRET=gmail-token
GMAIL_CLIENT_SECRET=gmail-oauth-client
